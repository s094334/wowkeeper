{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowkeeper-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  // ⚠️ database_id 還是佔位值，本機開發（--local / npm run dev）不會驗證它，
  //    但這樣直接 deploy 到 Cloudflare 會失敗（找不到該資料庫）。
  //    部署前要先：
  //      1. npx wrangler login
  //      2. npx wrangler d1 create wowkeeper-db，把回傳的 database_id 貼到下面
  //      3. npx wrangler d1 execute wowkeeper-db --remote --file=./worker/schema.sql 建表
  //      4. npx wrangler secret put JWT_SECRET（機密只走這裡，不進版控）
  //    database_id 只是識別碼、不是機密，可以正常進版控。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wowkeeper-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "routes": [{ "pattern": "wowkeeper.xin-ping.com", "custom_domain": true }],
  "preview_urls": true
}
