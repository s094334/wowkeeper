{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowkeeper-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wowkeeper-db",
      "database_id": "6de26d2e-0450-4af8-8b8e-e67d244201a6"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "routes": [{ "pattern": "wowkeeper.xin-ping.com", "custom_domain": true }],
  "preview_urls": true
}
