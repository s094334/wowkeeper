{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowkeeper-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  // database_id 只是識別碼、不是機密，可以正常進版控。
  // 本機開發（npm run dev）走 miniflare 的本機 D1，不會碰到這個遠端資料庫；
  // 遠端建表用：npx wrangler d1 execute wowkeeper-db --remote --file=./worker/schema.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wowkeeper-db",
      "database_id": "6de26d2e-0450-4af8-8b8e-e67d244201a6"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "routes": [{ "pattern": "wowkeeper.xin-ping.com", "custom_domain": true }],
  "preview_urls": true
}
